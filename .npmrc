# Pin pnpm's virtual-store directory names to one length for every platform.
#
# The default is platform-dependent — Windows uses 60 because of its path-length
# limit, every other platform uses 120 — and pnpm embeds that directory name in
# the symlink target it hands the resolver. tsdown then writes the resolved path
# into `lib/client.js` as a `//#region node_modules/.pnpm/<dir>/…` banner.
#
# So the same sources built on Windows and on Linux produced different bytes, and
# the `git diff --exit-code -- lib/` step in CI failed on a bundle that was
# correct on the machine that built it. The build was deterministic per machine,
# which is why this went unnoticed until a Linux runner tried it.
#
# 60 rather than 120: it is what Windows already used, so committing this changes
# no existing artifact, and every platform now truncates identically. Deleting
# this file reintroduces the CI failure above.
virtual-store-dir-max-length=60
